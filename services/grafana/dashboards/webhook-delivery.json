      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(events_accepted_total[$__rate_interval]))",
          "legendFormat": "accepted",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(delivery_attempts_total{result=\"delivered\"}[$__rate_interval]))",
          "legendFormat": "delivered",
          "range": true,
          "refId": "B"
        }
      ]
    },
