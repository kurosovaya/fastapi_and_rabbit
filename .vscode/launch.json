{
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug pytest file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/api/test_api.py",
        "-s"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
    }
  ]
}